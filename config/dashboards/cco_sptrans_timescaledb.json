        "y": 6
      },
      "id": 10,
      "title": "🚨 Diagnóstico Operacional CCO por Veículo (Validação GTFS Shapes & Headway)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Diagnóstico Operacional do CCO"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "colored-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH posicoes_com_shape AS (\n    SELECT \n        v.prefixo,\n        v.linha,\n        v.latitude,\n        v.longitude,\n        v.ultima_atualizacao,\n        (\n            SELECT s.shape_dist_traveled\n            FROM shapes s\n            WHERE s.shape_pt_lat BETWEEN v.latitude - 0.01 AND v.latitude + 0.01\n              AND s.shape_pt_lon BETWEEN v.longitude - 0.01 AND v.longitude + 0.01\n            ORDER BY (POW(s.shape_pt_lat - v.latitude, 2) + POW(s.shape_pt_lon - v.longitude, 2)) ASC\n            LIMIT 1\n        ) AS dist_percorrida_metros\n    FROM tb_posicao_atual_onibus v\n    WHERE v.linha = '$linha'\n),\nheadway_calculado AS (\n    SELECT \n        linha,\n        prefixo AS onibus,\n        LAG(prefixo, 1) OVER (PARTITION BY linha ORDER BY dist_percorrida_metros ASC) AS onibus_a_frente,\n        dist_percorrida_metros,\n        ultima_atualizacao,\n        ROUND(((dist_percorrida_metros - LAG(dist_percorrida_metros, 1) OVER (PARTITION BY linha ORDER BY dist_percorrida_metros ASC)) / 1000.0)::numeric, 2) AS dist_entre_onibus_km\n    FROM posicoes_com_shape\n)\nSELECT \n    linha AS \"Linha\",\n    onibus AS \"Ônibus (Prefixo)\",\n    COALESCE(onibus_a_frente::text, '-') AS \"Ônibus à Frente\",\n    REPLACE(ROUND(dist_percorrida_metros::numeric, 1)::text, '.', ',') || ' m' AS \"KM Acumulado Rota\",\n    COALESCE(REPLACE(dist_entre_onibus_km::text, '.', ','), '0') || ' km' AS \"Distância Entre Ônibus\",\n    CASE \n        WHEN dist_entre_onibus_km <= 0.20 THEN '🚨 COMBOIAMENTO / BUNCHING (Colados)'\n        WHEN dist_entre_onibus_km >= 5.0 THEN '🔴 BURACO DE OFERTA (Espaçamento Crítico)'\n        WHEN dist_entre_onibus_km >= 3.0 THEN '🟡 ATENÇÃO (Espaçamento Moderado)'\n        ELSE '🟢 REGULAR (Espaçamento Ideal)'\n    END AS \"Diagnóstico Operacional do CCO\"\nFROM headway_calculado\nWHERE dist_entre_onibus_km IS NOT NULL\n  AND linha = '$linha'\nORDER BY linha, dist_percorrida_metros ASC;",
          "refId": "A"
        }
      ]
    },
