      "id": 5,
      "title": "📏 Extensão do Trajeto (Ida + Volta)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "cyan",
            "mode": "fixed"
          },
          "noValue": "18.4 km",
          "unit": "lengthkm"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH extensao_por_sentido AS (\n    SELECT \n        t.route_id AS linha,\n        t.direction_id,\n        MAX(s.shape_dist_traveled) / 1000.0 AS dist_km\n    FROM shapes s\n    JOIN (\n        SELECT DISTINCT route_id, shape_id, direction_id \n        FROM trips \n        WHERE route_id = '$linha'\n    ) t ON s.shape_id = t.shape_id\n    GROUP BY t.route_id, t.direction_id\n)\nSELECT \n    ROUND(COALESCE(SUM(dist_km), 0)::numeric, 1) AS extensao_total\nFROM extensao_por_sentido;",
          "refId": "A"
        }
      ]
    },
    {
